# ===== E-commerce Operations Agent .env.example =====
# 复制为 .env 后编辑:cp .env.example .env
# .env 已在 .gitignore,绝不提交。

# --- 服务监听 ---
KBOT_ADDR=:8080
KBOT_ENVIRONMENT=dev               # dev | staging | prod
KBOT_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:5173

# --- 数据库(容器内主机名 db) ---
KBOT_DATABASE_URL=postgres://kbot:kbot@db:5432/kbot?sslmode=disable

# --- Redis(容器内主机名 redis) ---
KBOT_REDIS_URL=redis://redis:6379/0

# --- JWT(必填,长度 ≥ 32) ---
# 生成方法:openssl rand -base64 48 | tr -d '\n='
KBOT_JWT_SECRET_KEY=请改我__示例__32_chars_minimum_for_dev_only
# Tool 凭据的 AES-GCM 应用层加密密钥；生产请与 JWT 密钥分开并由 Secret 管理。
KBOT_CREDENTIAL_ENCRYPTION_KEY=请改我__tool_credential_encryption_key

# --- 模型（单一 OpenAI 兼容配置） ---
# 推荐(国内):
#   Doubao/火山方舟：https://console.volcengine.com/ark → API Key 管理
#   智谱 GLM: https://open.bigmodel.cn
# 国外:
#   OpenAI: https://platform.openai.com/api-keys
KBOT_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_API_KEY=
KBOT_LLM_MODEL=doubao-seed-2-1-pro-260628
# 可选：在保留上述主模型的同时，额外注册 DeepSeek 模型配置。
DEEPSEEK_API_KEY=
# 下列运行参数会与地址、模型名一起固化进不可变模型配置版本；改动后会追加版本。
KBOT_LLM_TIMEOUT_MS=120000
KBOT_LLM_MAX_RETRIES=1
# 单位：每百万 Token 的价格；只用于调用成本估算，不计费时可保持 0。
KBOT_LLM_INPUT_PRICE_PER_MILLION=0
KBOT_LLM_OUTPUT_PRICE_PER_MILLION=0
KBOT_LLM_CACHED_INPUT_PRICE_PER_MILLION=0

# --- KB 向量化嵌入器 ---
# local:仅供离线开发和单元测试使用的确定性词袋哈希，不用于真实检索评测。
# openai:走独立的 OpenAI 兼容 /embeddings 端点，不与聊天模型供应商或密钥耦合。
KBOT_EMBEDDER=openai
KBOT_EMBEDDER_BASE_URL=https://api.siliconflow.cn/v1
KBOT_EMBEDDER_API_KEY=               # 仅写入本地 .env/Secret Manager，禁止提交
KBOT_EMBEDDER_DIM=2048               # 必须 == kb_chunks.embedding halfvec(2048)
KBOT_EMBEDDER_MODEL=Qwen/Qwen3-Embedding-4B
KBOT_RERANKER_ENABLED=false            # true 时对混合召回候选进行模型重排
KBOT_RERANKER_BASE_URL=https://api.siliconflow.cn/v1
KBOT_RERANKER_API_KEY=                 # 留空时复用 KBOT_EMBEDDER_API_KEY
KBOT_RERANKER_MODEL=Qwen/Qwen3-Reranker-4B
KBOT_RERANKER_CANDIDATE_K=10           # 等权 RRF 先召回候选，再重排为调用方 top_k

# --- 可观测(可选;留空禁用 trace 导出) ---
KBOT_OTLP_ENDPOINT=
# 如启用 Langfuse:KBOT_OTLP_ENDPOINT=https://us.cloud.langfuse.com/api/public/otel/v1/traces
# Header 格式为逗号分隔 key=value；Langfuse Authorization 使用 Basic base64(public:secret)。
KBOT_OTLP_HEADERS=
KBOT_OTEL_SAMPLE_RATIO=1             # 0..1；生产按流量与成本下调
KBOT_OTEL_CAPTURE_CONTENT=false      # 生产默认关闭，避免采集 Prompt/响应中的敏感内容
KBOT_SERVICE_VERSION=dev
KBOT_LANGFUSE_UI_URL=                # 浏览器可访问的地址，如 http://localhost:3000
KBOT_LANGFUSE_PROJECT_ID=            # 用于 Admin 拼接 Trace 深链

# --- 首启自动 seed admin(仅 dev,prod 必须改 false) ---
KBOT_AUTOSEED_ADMIN=true
KBOT_AUTOSEED_ADMIN_EMAIL=admin@example.com
KBOT_AUTOSEED_ADMIN_PASSWORD=admin12345
KBOT_TOOL_ALLOWED_HOSTS=crossborder-sim
KBOT_TOOL_ALLOW_PRIVATE_NETWORK=false
KBOT_KB_MARKDOWN_ALLOWED_ROOTS=projects
